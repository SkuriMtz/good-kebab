# Copia este archivo a ".env.local" y llena los valores reales.
# NUNCA subas ".env.local" a git — contiene claves secretas.

# Los sacas de tu proyecto en https://supabase.com (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La sacas en https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=

# Dominios permitidos para llamar a tu API (separados por coma, sin espacios)
ALLOWED_ORIGINS=http://localhost:3000
